{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm test && node scripts/stage-helpers.mjs && npm run build"
  },
  "bundle": {
    "externalBin": ["binaries/slopshop-raw", "binaries/slopshop-ai"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "MAINTAINER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/laBoiteBleue/slopshop/releases/download/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
